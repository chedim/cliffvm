test an unprivileged pack cannot set privileged by the direct path (owned Pack class, existing target)
load priv/packown.c1f
PACK evil 1
IMPORT packown 1
Trig.go on-setter w:
  ALWAYS: Pack:x.privileged = True
given Pack:x {}
given Trig:t {}
write Trig:t.go = 1
privileged x = false
reads Pack:x.privileged = null

