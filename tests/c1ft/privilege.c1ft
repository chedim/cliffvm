test a pack setter grants and the grant outlives the granter
load priv/root.c1f
given Pack:kid {"text": "PACK kid 1\nBox.k getter: 'k'\n"}
given Trig:t {}
write Trig:t.go = 1
-- root is not privileged: its grant is refused
privileged kid = false
given Pack:root {"privileged": true}
write Trig:t.go = 2
privileged kid = true
-- the writer that wrote it
reads Pack:kid.granted_by = "pack:root:grant-kid"
reads Pack:kid.privileged = true
-- the journal holds the outside writes only: the grant of a setter and `granted_by` are derived
journal only outside
journal lacks write granted_by
-- revoking the granter does not revoke what it granted
write Pack:root.privileged = false
privileged root = false
privileged kid = true
-- a privileged writer revokes
given Pack:rev {"privileged": true, "text": "PACK rev 1\nRev.go on-setter r:\n  ALWAYS: Pack:kid.privileged = False\n"}
given Rev:r {}
write Rev:r.go = 3
privileged kid = false
reads Pack:kid.granted_by = null

test a removed pack leaves no stale values of its getters
given Box:a {"w": 1, "keep": "me"}
given Pack:mine {"text": "PACK mine 1\nBox.label getter: 'l' + str(this.w)\nBox.size getter: this.w * 10\n"}
reads Box:a.label = "l1"
reads Box:a.size = 10
write Pack:mine.text = ""
-- the getter's value is cleared
reads Box:a.label = null
reads Box:a.size = null
-- plain properties stay
reads Box:a.w = 1
reads Box:a.keep = "me"
-- and the store row
row Box:a lacks label
-- journal-neutral
journal lacks write label
journal lacks write size

test a getter another pack still defines is kept when a pack is removed
given Box:a {"w": 1}
given Pack:a {"text": "PACK a 1\nBox.label getter: 'a'\n"}
given Pack:b {"text": "PACK b 1\nIMPORT a 1\nBox.size getter: 1\n"}
write Pack:b.text = ""
reads Box:a.size = null
reads Box:a.label = "a"

test the journal replays a grant and ends in the same privilege state
load priv/root.c1f
given Pack:kid {"text": "PACK kid 1\nBox.k getter: 'k'\n"}
given Pack:root {"privileged": true}
given Trig:t {}
write Trig:t.go = 1
privileged kid = true
privileged root = true
replay
privileged kid = true
privileged root = true
reads Pack:kid.privileged = true
reads Pack:kid.granted_by = "pack:root:grant-kid"
same all
