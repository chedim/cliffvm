-- PRIVILEGE (docs/c1f-layers.md, "Privilege"): exemption from rule B (a pack writes only classes it owns or imports) ONLY. Rule A stays (only the owner defines getters and setters on a class). The grant is
-- a write, `Pack:<name>.privileged = true`, by a privileged writer; the host records `granted_by` from the writer; the boot pack is the root of trust. Converted from tests/privilege_1143.rs; what stays
-- Rust there is the rule-A load of a pack that was granted before it loads, and the restart that reads a stored grant back.
-- `own` owns Cls; `plain` is a pack that imports nothing and tries to write it, several ways. The packs are in priv/.

test an unprivileged pack still cannot write or create a class it does not own
load priv/own.c1f
load priv/plain.c1f
given Cls:a {}
given Trig:t {}
write Trig:t.go = 1
write Trig:t.mk = 1
reads Cls:a.val = null
-- the receipt
eval "can't write" in str(Cls:a.refused) or "can't write" in str(Trig:t.refused) = true
-- creation of a foreign class is dropped
absent Cls:made

test a granted pack writes and creates any class and a revoke takes it back
load priv/own.c1f
load priv/plain.c1f
given Cls:a {}
given Trig:t {}
privileged plain = false
-- the grant (an outside write: the person's)
given Pack:plain {"privileged": true}
privileged plain = true
reads Pack:plain.granted_by = "person"
write Trig:t.go = 1
write Trig:t.mk = 1
reads Cls:a.val = 1
-- created
reads Cls:made.val = 1
-- revoke: a write of false; the next tries are refused again
write Pack:plain.privileged = false
privileged plain = false
write Cls:a.val = 0
write Trig:t.go = 2
-- refused after the revoke
reads Cls:a.val = 0

test a creation of a class no pack owns works for a privileged pack only
PACK plain 1
Trig.mk on-setter c:
  ALWAYS: Nobody:x.val = 1
given Trig:t {}
write Trig:t.mk = 1
absent Nobody:x
given Pack:plain {"privileged": true}
write Trig:t.mk = 2
reads Nobody:x.val = 1

test an unprivileged pack cannot set privileged by the direct path (not owned Pack class, existing target)
PACK evil 1
Trig.go on-setter w:
  ALWAYS: Pack:x.privileged = True
given Pack:x {}
given Trig:t {}
write Trig:t.go = 1
privileged x = false
reads Pack:x.privileged = null

test an unprivileged pack cannot set privileged by the computed path (not owned Pack class, existing target)
PACK evil 1
Trig.go on-setter w:
  ALWAYS: Pack:x.['privileged'] = True
given Pack:x {}
given Trig:t {}
write Trig:t.go = 1
privileged x = false
reads Pack:x.privileged = null

test an unprivileged pack cannot set privileged by the constructor path (not owned Pack class, existing target)
PACK evil 1
Trig.go on-setter w:
  ALWAYS: Pack:x = Pack(privileged: True)
given Pack:x {}
given Trig:t {}
write Trig:t.go = 1
privileged x = false
reads Pack:x.privileged = null

test an unprivileged pack cannot set privileged by the chain path (not owned Pack class, existing target)
PACK evil 1
Trig.go on-setter w:
  ALWAYS: Hop:h.n = 1
Hop.n on-setter v:
  ALWAYS: Pack:x.privileged = True
given Pack:x {}
given Trig:t {}
write Trig:t.go = 1
privileged x = false
reads Pack:x.privileged = null

test an unprivileged pack cannot set privileged by the direct path (not owned Pack class, new target)
PACK evil 1
Trig.go on-setter w:
  ALWAYS: Pack:x.privileged = True
given Trig:t {}
write Trig:t.go = 1
privileged x = false
reads Pack:x.privileged = null

